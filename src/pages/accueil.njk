---
pagination:
  data: langues
  size: 1
  alias: lang
layout: base.njk
cle: accueil
chemin: ""
dataPage: home
prechargerPortfolio: true
schema: { type: ProfilePage, rel: mainEntity }
permalink: "{{ '' if lang == 'fr' else 'en/' }}index.html"
---
{%- set A = textes.accueil -%}
{%- set pfx = ("./" if lang == "fr" else "../") + ("" if lang == "fr" else "en/") -%}
{%- set arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>' | safe -%}
{%- set ext = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>' | safe -%}
    <section class="hero" aria-label="{{ A.hero_aria | tr(lang) }}">
      <div class="hero-slides" aria-hidden="true"></div>
      <div class="container hero-content">
        <h1 class="hero-h1">
          <span class="eyebrow" data-enter style="--delay:100ms">{{ A.hero_surtitre | tr(lang) }}</span>
          <span class="hero-title split" style="--base:250ms">{{ A.hero_prenom | tr(lang) }} <span class="accent">{{ A.hero_nom | tr(lang) }}</span></span>
        </h1>
        <div class="hero-bottom">
          <div>
            <div class="hero-actions" data-enter style="--delay:780ms">
              <a class="btn btn-primary" href="{{ pfx }}portfolios/">{{ A.bouton_portfolio | tr(lang) }} {{ arrow }}</a>
              <a class="btn btn-ghost" href="#reel">{{ A.bouton_reel | tr(lang) }}</a>
            </div>
          </div>
          <div class="hero-meta" data-enter style="--delay:900ms">
            <button class="motion-toggle" type="button" aria-pressed="false" data-label-pause="{{ A.pause | tr(lang) }}" data-label-play="{{ A.lecture | tr(lang) }}">
              <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
              <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
              <span class="motion-label">{{ A.pause | tr(lang) }}</span>
            </button>
            <span class="hero-caption" aria-live="off"></span>
            <div class="hero-progress" role="group" aria-label="{{ A.choisir_image_aria | tr(lang) }}"></div>
          </div>
        </div>
      </div>
      <span class="scroll-cue" aria-hidden="true"></span>
    </section>

    <section class="section" aria-labelledby="sel-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow reveal">{{ A.selection_surtitre | tr(lang) }}</p>
            <h2 class="section-title split" id="sel-title">{{ A.selection_titre | tr(lang) }}</h2>
          </div>
          <a class="section-link reveal" href="{{ pfx }}portfolios/">{{ A.selection_lien | tr(lang) }} {{ arrow }}</a>
        </div>
        <div class="featured-grid" id="featured"></div>
      </div>
    </section>

    <section class="section" id="reel" aria-labelledby="reel-title" style="padding-top:0">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow reveal">{{ A.reel_surtitre | tr(lang) }}</p>
            <h2 class="section-title split" id="reel-title">{{ A.reel_titre | tr(lang) }}</h2>
          </div>
          <a class="section-link reveal" href="{{ pfx }}videos/">{{ A.reel_lien | tr(lang) }} {{ arrow }}</a>
        </div>
        <div class="reveal" id="demo-reel"></div>
      </div>
    </section>

    <section class="section" aria-labelledby="disc-title" style="padding-top:0">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow reveal">{{ A.disciplines_surtitre | tr(lang) }}</p>
            <h2 class="section-title split" id="disc-title">{{ A.disciplines_titre | tr(lang) }}</h2>
          </div>
        </div>
        <div class="disciplines" id="disciplines"></div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="cta-bg" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow reveal">{{ A.cta_surtitre | tr(lang) }}</p>
        <h2 class="cta-title split" id="cta-title" style="margin-top:20px">{{ A.cta_titre | tr(lang) }}</h2>
        <p class="reveal">{{ A.cta_texte | tr(lang) }}</p>
        <div class="cta-actions reveal">
          <a class="btn btn-primary" href="{{ pfx }}contact/">{{ A.cta_bouton | tr(lang) }} {{ arrow }}</a>
          <a class="btn btn-ghost" data-site-link="imdb" href="{{ site.imdb if lang == 'fr' else (site.imdb_en or site.imdb) }}" target="_blank" rel="noopener">{{ A.cta_imdb | tr(lang) }} {{ ext }}<span class="sr-only"> {{ textes.commun.nouvel_onglet | tr(lang) }}</span></a>
        </div>
      </div>
    </section>
